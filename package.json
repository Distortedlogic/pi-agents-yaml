{
	"name": "pi-agents-yaml",
	"version": "0.1.0",
	"private": true,
	"description": "Shared AGENTS.yml loading, validation, discovery, graph resolution, and file selection for Pi packages.",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Distortedlogic/pi-agents-yaml.git"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"exports": "./src/index.ts",
	"files": [
		"src",
		"skills"
	],
	"pi": {
		"skills": [
			"./skills"
		]
	},
	"scripts": {
		"check": "npm run typecheck && npm run lint && npm test",
		"format": "biome check --write .",
		"lint": "biome check .",
		"test": "node --experimental-strip-types --test test/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"globby": "16.2.4",
		"typebox": "1.3.34",
		"yaml": "2.9.1"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "0.85.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@types/node": "22.20.3",
		"typescript": "7.0.2"
	}
}
